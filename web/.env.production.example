# Production environment - set these in your hosting platform (Vercel, etc.)
# Use for https://www.digitproperties.com (apex redirects to www on Vercel)

# MongoDB Atlas (same as local; ensure IP whitelist allows 0.0.0.0/0 for Vercel)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority

# Cloudinary (same as local)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Auth (NextAuth) - Production domain
NEXTAUTH_URL=https://www.digitproperties.com
NEXTAUTH_SECRET=<generate-with-openssl-rand-hex-32>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
NEXT_PUBLIC_FACEBOOK_APP_ID=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=

# Flutterwave
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

# Paystack
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# FCM (Firebase)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# App
NEXT_PUBLIC_APP_URL=https://www.digitproperties.com

# Admin social posting (Facebook Page + linked Instagram + X). See web/.env.example for how to generate tokens.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
# INSTAGRAM_ACCOUNT_ID=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# OpenAI (daily trend posts + images)
OPENAI_API_KEY=
# Vercel Cron Authorization bearer (also used by /api/cron/trends)
CRON_SECRET=

# Google AdSense (Auto ads script loads sitewide when this is set)
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=pub-4366651160831084
# Keep false once approved (true only disables Adsterra during review)
ADSENSE_REVIEW_MODE=false
