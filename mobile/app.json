{
  "expo": {
    "name": "Digit Properties",
    "slug": "digit-properties",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "digitproperties",
    "newArchEnabled": true,
    "primaryColor": "#0d9488",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d9488"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.digitproperties.app",
      "buildNumber": "2",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDisplayName": "Digit Properties",
        "NSCameraUsageDescription": "Digit Properties uses the camera so you can add photos to property listings.",
        "NSPhotoLibraryUsageDescription": "Digit Properties needs photo access so you can attach listing images from your library.",
        "NSPhotoLibraryAddUsageDescription": "Digit Properties may save listing photos to your library when you choose to download them.",
        "NSLocationWhenInUseUsageDescription": "Digit Properties uses your location to pin a listing on the map and show nearby properties.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.digitproperties.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d9488"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Digit Properties uses your location to pin a listing on the map and show nearby properties."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Digit Properties needs photo access so you can attach listing images from your library.",
          "cameraPermission": "Digit Properties uses the camera so you can add photos to property listings."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0d9488",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220
        }
      ],
      "react-native-maps",
      "expo-font",
      "expo-updates"
    ],
    "runtimeVersion": "1.0.0",
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/ea37377b-82aa-4527-99e8-1e98bcae6980",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ea37377b-82aa-4527-99e8-1e98bcae6980"
      }
    },
    "owner": "bhadmusfrancis"
  }
}
